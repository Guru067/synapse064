			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql import functions as F"
				],
				"execution_count": 10
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"df = spark.read.format(\"csv\") \\\n",
					"    .option(\"header\", \"true\") \\\n",
					"    .option(\"inferSchema\", \"true\") \\\n",
					"    .load(\"abfss://source@storage075.dfs.core.windows.net/SuperStoreOrders.csv\")\n",
					"\n",
					"display(df.limit(5))"
				],
				"execution_count": 7
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"df.printSchema()        # See column names and types            # Show first 10 rows\n",
					"df.count()              # Total row count\n",
					"df.columns              # List all columns\n",
					"display(df.limit(5))             # Rich table view in Synapse notebook ✅"
				],
				"execution_count": 9
			},
			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql.functions import sum, avg, max, min, count,round"
				],
				"execution_count": 18
			},
			{
				"cell_type": "code",
				"source": [
					"df.groupBy(\"segment\") \\\n",
					"  .agg(sum(\"sales\").alias(\"Total_Sales\")) \\\n",
					"  .orderBy(\"Total_Sales\", ascending=False) \\\n",
					"  .show()"
				],
				"execution_count": 14
			},
			{
				"cell_type": "code",
				"source": [
					"df.groupBy(\"category\") \\\n",
					"  .agg(\n",
					"      sum(\"sales\").alias(\"Total_Sales\"),\n",
					"      round(avg(\"sales\"),2).alias(\"Avg_Sales\"),\n",
					"      count(\"order_id\").alias(\"Order_Count\")\n",
					"  ).show()"
				],
				"execution_count": 19
			},
			{
				"cell_type": "code",
				"source": [
					"# Check nulls in each column\n",
					"from pyspark.sql.functions import col, isnan, when, count\n",
					"\n",
					"df.select([count(when(col(c).isNull(), c)).alias(c) for c in df.columns]).show()\n",
					"\n",
					"# Drop rows with any null\n",
					"df_clean = df.dropna()\n",
					"\n",
					"# Fill nulls with a value\n",
					"df_filled = df.fillna({\"sales\": 0, \"quantity\": 1})"
				],
				"execution_count": 20
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"from pyspark.sql.functions import col, round\n",
					"\n",
					"# Add Total Revenue column\n",
					"df = df.withColumn(\"Total_Revenue\", round(col(\"sales\") * col(\"quantity\"), 2))\n",
					"\n",
					"# Add a category label\n",
					"from pyspark.sql.functions import when\n",
					"df = df.withColumn(\"Sales_Category\",\n",
					"    when(col(\"sales\") <= 5000, \"Low\")\n",
					"    .when((col(\"Total_Revenue\") > 5000) & (col(\"Total_Revenue\") <= 10000), \"Medium\")\n",
					"    .otherwise(\"High\")\n",
					")\n",
					"\n",
					"display(df.limit(5))\n",
					"df.select(max(\"Total_Revenue\")).show()\n",
					"df.select(min(\"Total_Revenue\")).show()"
				],
				"execution_count": 28
			},
